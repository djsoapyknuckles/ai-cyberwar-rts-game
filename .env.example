# Copy to .env (git ignores it) for headless runs against a cloud model (D-020):
#   npm run llm-match -- --provider openai --model <model> --human control --matches 30 --with-control
# Never commit a real key. In the browser, players type their own key instead (?ai=llm&provider=openai).
OPENAI_API_KEY=
# Optional: another OpenAI-compatible API (Groq, LM Studio, Ollama's /v1, ...).
OPENAI_BASE_URL=
# Optional: OpenRouter (D-025), default model anthropic/claude-haiku-5.5 unless --model is given.
#   npm run llm-match -- --provider openrouter --human control --matches 30 --with-control
OPENROUTER_API_KEY=
# Optional: a local Voxta server as the General's LLM (D-022): an API key with the inference scope.
#   npm run llm-match -- --provider voxta --human control --matches 30 --with-control
VOXTA_API_KEY=
# Optional: Voxta's OpenAI-compatible address, default http://localhost:5384/v1.
VOXTA_URL=
